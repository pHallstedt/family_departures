  "services": {
    "refresh": {
      "name": "Refresh",
      "description": "Recompute departure plans, optionally for a single person.",
      "fields": {
        "person_id": {
          "name": "Person",
          "description": "Profile id to refresh. Leave empty to refresh everyone."
        }
      }
    },
    "mark_departed": {
      "name": "Mark departed",
      "description": "Close the current plan after a confirmed departure.",
      "fields": {
        "person_id": { "name": "Person", "description": "Profile id." },
        "plan_id": {
          "name": "Plan id",
          "description": "The current plan id to close."
        }
      }
    },
    "set_override": {
      "name": "Set day override",
      "description": "Override transport mode, attendance or arrival time for a date.",
      "fields": {
        "person_id": { "name": "Person", "description": "Profile id." },
        "date": {
          "name": "Date",
          "description": "The local date the override applies to."
        },
        "mode": {
          "name": "Transport mode",
          "description": "Override the day's travel mode."
        },
        "attendance": {
          "name": "Attendance",
          "description": "Override the day's attendance."
        },
        "arrival_time": {
          "name": "Arrival time",
          "description": "Replace the day's arrival requirement (local time)."
        }
      }
    },
    "clear_override": {
      "name": "Clear day override",
      "description": "Remove a per-day override.",
      "fields": {
        "person_id": { "name": "Person", "description": "Profile id." },
        "date": {
          "name": "Date",
          "description": "The local date whose override is removed."
        }
      }
    },
    "get_alternatives": {
      "name": "Get alternatives",
      "description": "Return the reachable journeys for the current plan.",
      "fields": {
        "person_id": { "name": "Person", "description": "Profile id." }
      }
    },
    "select_journey": {
      "name": "Select journey",
      "description": "Record an explicitly chosen journey for the current plan.",
      "fields": {
        "person_id": { "name": "Person", "description": "Profile id." },
        "plan_id": {
          "name": "Plan id",
          "description": "The current plan id."
        },
        "journey_id": {
          "name": "Journey id",
          "description": "The journey to select."
        }
      }
    },
    "reopen_today": {
      "name": "Reopen today",
      "description": "Reopen today's mission after it was closed by a departure.",
      "fields": {
        "person_id": { "name": "Person", "description": "Profile id." }
      }
